#!/usr/bin/env bash
set -e

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    printf '%s\n' 'uip: nvm is unavailable' >&2
    exit 127
fi

. "$NVM_DIR/nvm.sh"
version=$(nvm version default)
cli="$NVM_DIR/versions/node/$version/bin/uip"
if [ ! -x "$cli" ]; then
    printf 'uip: CLI is not installed for nvm default Node %s\n' "$version" >&2
    exit 127
fi

exec "$cli" "$@"
