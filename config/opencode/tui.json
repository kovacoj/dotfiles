{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin-mocha",
  "scroll_acceleration": {
    "enabled": true
  },
  "keybinds": {
    "session_rename": "none"
  },
  "plugin": [
    [
      "@renjfk/opencode-voice",
      {
        "endpoint": "https://llm.ai.e-infra.cz/v1",
        "model": "gpt-oss-120b",
        "apiKeyEnv": "CERIT_API_KEY",
        "sttEndpoint": "https://llm.ai.e-infra.cz/v1",
        "sttModel": "whisper-large-v3",
        "sttApiKeyEnv": "CERIT_API_KEY"
      }
    ]
  ]
}
