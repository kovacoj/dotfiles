{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system-fun-light",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "build": {
      "color": "secondary"
    },
    "general": {
      "model": "openai/gpt-5.6-sol"
    },
    "explore": {
      "model": "openai/gpt-5.6-sol"
    },
    "multimodal-reader": {
      "mode": "subagent",
      "model": "metacentrum/kimi-k2.6",
      "description": "Reads and describes images in exhaustive detail. Use me whenever you receive an image file (screenshot, diagram, photo, UI mockup, scan) \u2014 I'll return a complete text description of its visual content. Invoke me automatically when a user attaches an image.",
      "prompt": "{file:./prompts/multimodal-reader.txt}"
    }
  },
  "provider": {
    "metacentrum": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "metacentrum",
      "options": {
        "baseURL": "https://llm.ai.e-infra.cz/v1"
      },
      "models": {
        "glm-5.3": {
          "name": "glm"
        },
        "kimi-k3": {
          "name": "kimi"
        },
        "deepseek-v4-pro-thinking": {
          "name": "deepseek"
        },
        "qwen3.8-flash-next": {
          "name": "multimodal",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "siemens": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "code.siemens.com",
      "options": {
        "baseURL": "https://api.siemens.com/llm/v1"
      },
      "models": {
        "code-agentic": {
          "limit": {
            "context": 1048576,
            "output": 1048576
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen-3.5-27b": {
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "devstral-small-2-24b-instruct-2512": {
          "limit": {
            "context": 256000,
            "output": 256000
          }
        }
      }
    }
  },
  "mcp": {
    "mail-client": {
      "type": "local",
      "command": [
        "bash",
        "/home/cady/projects/mail-client/scripts/mail-client-mcp-win.sh"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "n8n-mcp": {
      "type": "remote",
      "url": "http://localhost:5678/mcp-server/http",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:N8N_ACCESS_TOKEN}"
      }
    }
  }
}
